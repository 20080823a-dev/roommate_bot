# Discord 機器人認證憑證
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase 連線網址 (建議使用明文的 connection string)
DATABASE_URL=postgresql://postgres:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Render 部署綁定連接埠 (預設 8080)
PORT=8080

# 全域管理員 Discord User ID 列表 (多組以逗號分隔，不可留空)
ADMIN_USER_IDS=123456789012345678,987654321098765432

# 你自己實際居住的 Discord 伺服器 ID (永遠不計入 MAX_GUILDS 計算)
HOME_GUILD_ID=112233445566778899

# 最大外部租戶伺服器承載上限 (不含 HOME_GUILD_ID)
MAX_GUILDS=5

# 單一伺服器允許註冊的最大室友數量
MAX_ROOMMATES_PER_GUILD=10

GEMINI_API_KEY=
AI_CHANNEL_ID=

PYTHON_VERSION=3.11.9
